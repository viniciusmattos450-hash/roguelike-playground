            r2 = ttk.Frame(self.engine_frame); r2.pack(fill=tk.X, pady=(4, 0))
            ttk.Label(r2, text="LoRA (opcional):", width=15).pack(side=tk.LEFT)
            ttk.Combobox(r2, textvariable=self.var_sdxl_lora,
