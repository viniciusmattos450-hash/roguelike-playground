class ComfyClient:
    def __init__(self, server):
        self.server = server
        self.client_id = str(uuid.uuid4())
        self.ws = None

    def connect_ws(self):
        try:
            self.ws = websocket.WebSocket()
            self.ws.connect(f"ws://{self.server}/ws?clientId={self.client_id}")
            return True
        except Exception as e:
            print(f"[!] WS: {e}"); return False

    def is_alive(self):
        try: requests.get(f"http://{self.server}/history", timeout=2); return True
        except Exception: return False

    def queue(self, workflow):
        try:
            r = requests.post(f"http://{self.server}/prompt",
                              json={"prompt": workflow, "client_id": self.client_id},
                              timeout=10)
            return r.json()
        except Exception as e:
            print(f"[!] queue: {e}"); return None

    def history(self, prompt_id):
        r = requests.get(f"http://{self.server}/history/{prompt_id}", timeout=10)
        return r.json()

    def fetch_image(self, filename, subfolder, folder_type):
        r = requests.get(f"http://{self.server}/view",
                         params={"filename": filename, "subfolder": subfolder,
                                 "type": folder_type}, timeout=30)
        return r.content

    def upload_image(self, filepath):
        try:
            with open(filepath, "rb") as f:
                r = requests.post(f"http://{self.server}/upload/image",
                                  files={"image": (os.path.basename(filepath),
                                                   f, "image/png")}, timeout=30)
            resp = r.json()
            if resp.get("subfolder"):
                return f"{resp['subfolder']}/{resp['name']}"
            return resp.get("name")
        except Exception as e:
            print(f"[!] upload: {e}"); return None

    def object_info(self, node_class):
        try:
            r = requests.get(f"http://{self.server}/object_info/{node_class}",
                             timeout=5)
            info = r.json()
            return info.get(node_class)
        except Exception:
            return None

    def node_exists(self, node_class):
        return self.object_info(node_class) is not None

    def list_options(self, node_class, input_name):
        info = self.object_info(node_class)
        if not info:
            return []
        val = None
        try:
            val = info["input"]["required"][input_name][0]
        except Exception:
            try:
                val = info["input"]["optional"][input_name][0]
            except Exception:
                return []
        if val is None:
            return []
        if isinstance(val, list):
            return val
        if isinstance(val, str):
            return [val]
        try:
            return list(val)
        except Exception:
            return []

    def wait_for(self, prompt_id, on_progress=None):
        try:
            while True:
                msg = self.ws.recv()
                if isinstance(msg, str):
                    m = json.loads(msg)
                    t = m.get("type")
                    if t == "progress" and on_progress:
                        d = m["data"]
                        on_progress(d.get("value", 0), d.get("max", 1))
                    elif t == "executing":
                        d = m["data"]
                        if d.get("node") is None and d.get("prompt_id") == prompt_id:
                            return True, "ok"
                    elif t == "execution_error":
                        d = m["data"]
                        return False, d.get("exception_message", "erro")
        except Exception as e:
            return False, f"ws: {e}"


