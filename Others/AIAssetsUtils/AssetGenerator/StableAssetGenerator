class SettingsDialog(tk.Toplevel):
    def __init__(self, parent, app):
        super().__init__(parent)
        self.app = app
        self.title("Settings — Presets de Prompt")
        self.geometry("960x640")
        self.minsize(840, 540)

        self._current_cat = list(CATEGORIES.keys())[0]
        self._current_name = None

        self._build_ui()
        self._refresh_category_list()

    def _build_ui(self):
        root = ttk.Frame(self, padding=8)
        root.pack(fill=tk.BOTH, expand=True)

        top = ttk.Frame(root); top.pack(fill=tk.X, pady=(0, 6))
        ttk.Label(top, text="Categoria:").pack(side=tk.LEFT)
        self.var_cat = tk.StringVar(value=self._current_cat)
        cmb = ttk.Combobox(top, textvariable=self.var_cat,
                           values=[f"{k} — {v['title']}" for k, v in CATEGORIES.items()],
                           width=40, state="readonly")
        cmb.pack(side=tk.LEFT, padx=6)
        cmb.bind("<<ComboboxSelected>>", lambda e: self._on_cat_change())

        body = ttk.Frame(root); body.pack(fill=tk.BOTH, expand=True)

        left = ttk.LabelFrame(body, text="Presets", padding=6)
        left.pack(side=tk.LEFT, fill=tk.BOTH, expand=True)
        self.listbox = tk.Listbox(left, exportselection=False)
        self.listbox.pack(side=tk.LEFT, fill=tk.BOTH, expand=True)
        sb = ttk.Scrollbar(left, command=self.listbox.yview)
        sb.pack(side=tk.RIGHT, fill=tk.Y)
        self.listbox.config(yscrollcommand=sb.set)
        self.listbox.bind("<<ListboxSelect>>", lambda e: self._on_select())

        right = ttk.LabelFrame(body, text="Editor", padding=6)
        right.pack(side=tk.LEFT, fill=tk.BOTH, expand=True, padx=(8, 0))

        r1 = ttk.Frame(right); r1.pack(fill=tk.X)
        ttk.Label(r1, text="Nome:", width=10).pack(side=tk.LEFT)
        self.var_name = tk.StringVar()
        ttk.Entry(r1, textvariable=self.var_name).pack(side=tk.LEFT, fill=tk.X, expand=True)

        ttk.Label(right, text="Sufixo:").pack(anchor="w", pady=(8, 0))
        self.txt_value = tk.Text(right, height=8, wrap="word")
        self.txt_value.pack(fill=tk.BOTH, expand=True)

        btns = ttk.Frame(right); btns.pack(fill=tk.X, pady=(8, 0))
        ttk.Button(btns, text="Novo", command=self._on_new).pack(side=tk.LEFT)
        ttk.Button(btns, text="Salvar preset", command=self._on_save).pack(side=tk.LEFT, padx=4)
        ttk.Button(btns, text="Deletar", command=self._on_delete).pack(side=tk.LEFT)
        ttk.Button(btns, text="Restaurar padrão", command=self._on_reset_all).pack(side=tk.LEFT, padx=8)

        foot = ttk.Frame(root); foot.pack(fill=tk.X, pady=(8, 0))
        self.status = ttk.Label(foot, text="", foreground="#666")
        self.status.pack(side=tk.LEFT)
        ttk.Button(foot, text="Fechar", command=self.destroy).pack(side=tk.RIGHT)
        ttk.Button(foot, text="Salvar tudo em disco",
                   command=self._on_save_all).pack(side=tk.RIGHT, padx=6)

    def _on_cat_change(self):
        sel = self.var_cat.get()
        cat_key = sel.split(" — ")[0].strip()
        if cat_key in CATEGORIES:
            self._current_cat = cat_key
            self._refresh_category_list()

    def _refresh_category_list(self):
        self.listbox.delete(0, tk.END)
        presets = self.app.presets.get(self._current_cat, {})
        for name in presets.keys():
            self.listbox.insert(tk.END, name)
        self.var_name.set("")
        self.txt_value.delete("1.0", tk.END)
        self._current_name = None

    def _on_select(self):
        sel = self.listbox.curselection()
        if not sel: return
        name = self.listbox.get(sel[0])
        presets = self.app.presets.get(self._current_cat, {})
        self._current_name = name
        self.var_name.set(name)
        self.txt_value.delete("1.0", tk.END)
        self.txt_value.insert("1.0", presets.get(name, ""))

    def _on_new(self):
        self._current_name = None
        self.var_name.set("Novo preset")
        self.txt_value.delete("1.0", tk.END)
        self.txt_value.insert("1.0", ", ")

    def _on_save(self):
        name = self.var_name.get().strip()
        value = self.txt_value.get("1.0", tk.END).strip()
        if not name or not value:
            messagebox.showwarning("Vazio", "Preencha nome e sufixo."); return
        cat = self.app.presets.setdefault(self._current_cat, {})
        if self._current_name and self._current_name != name:
            if self._current_name in cat:
                del cat[self._current_name]
        cat[name] = value
        self._current_name = name
        self._refresh_category_list()
        try:
            idx = list(cat.keys()).index(name)
            self.listbox.selection_set(idx)
        except Exception:
            pass
        self.status.config(text=f"Preset '{name}' salvo (em memória).",
                            foreground="green")
        self._notify_tabs()

    def _on_delete(self):
        if not self._current_name: return
        if not messagebox.askyesno("Deletar", f"Deletar '{self._current_name}'?"):
            return
        cat = self.app.presets.get(self._current_cat, {})
        if self._current_name in cat:
            del cat[self._current_name]
        self._current_name = None
        self._refresh_category_list()
        self._notify_tabs()

    def _on_reset_all(self):
        if not messagebox.askyesno("Restaurar", "Restaurar TODOS os presets padrão?"):
            return
        self.app.presets = {k: dict(v["presets"]) for k, v in CATEGORIES.items()}
        self._refresh_category_list()
        self._notify_tabs()

    def _on_save_all(self):
        if save_presets(self.app.presets):
            self.status.config(text=f"Salvo em {PRESETS_FILE}", foreground="green")
            self._notify_tabs()
        else:
            self.status.config(text="Erro ao salvar.", foreground="red")

    def _notify_tabs(self):
        for tab in self.app.tabs.values():
            tab.reload_presets()


