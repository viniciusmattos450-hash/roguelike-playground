class Models:
    def __init__(self):
        self.flux_unets = []
        self.flux_clips = []
        self.flux_vaes = []
        self.ckpts = []
        self.loras = []
        self.rmbg_models = []
        self.upscale_models = []
        self.has_rmbg = False
        self.i2t_method = None
        self.i2t_node = None
        self.flux_ok = False
        self.sdxl_ok = False
        # Character Sheet
        self.klein4b_unet = None
        self.klein9b_unet = None
        self.tripleview_lora = None
        self.quadview_lora = None
        self.spritesheet_lora = None

    def refresh(self, client):
        self.flux_unets = client.list_options("UnetLoaderGGUF", "unet_name")
        self.flux_clips = client.list_options("CLIPLoaderGGUF", "clip_name")
        self.flux_vaes  = client.list_options("VAELoader", "vae_name")
        self.ckpts      = client.list_options("CheckpointLoaderSimple", "ckpt_name")
        self.loras      = client.list_options("LoraLoader", "lora_name")
        self.upscale_models = client.list_options("UpscaleModelLoader", "model_name")

        self.flux_ok = bool(self.flux_unets and self.flux_clips and self.flux_vaes)
        self.sdxl_ok = bool(self.ckpts)

        # Detecção de Klein 4B e 9B
        for u in self.flux_unets:
            ul = u.lower()
            if "klein" in ul and "4b" in ul:
                self.klein4b_unet = u
            if "klein" in ul and "9b" in ul:
                self.klein9b_unet = u

        # LoRAs de Character Sheet
        self.tripleview_lora = None
        self.quadview_lora = None
        self.spritesheet_lora = None
        for l in self.loras:
            ll = l.lower()
            if "tripleview" in ll:
                self.tripleview_lora = l
            elif "quadview" in ll:
                self.quadview_lora = l
            elif "spritesheet" in ll or "sprite_sheet" in ll:
                self.spritesheet_lora = l

        # RMBG
        info = client.object_info("RMBG")
        if info:
            self.has_rmbg = True
            try:
                self.rmbg_models = info["input"]["required"]["model"][0] or []
                if isinstance(self.rmbg_models, str):
                    self.rmbg_models = [self.rmbg_models]
            except Exception:
                self.rmbg_models = ["RMBG-2.0"]

        # Image-to-text
        i2t_candidates = [
            ("Florence2Run", "florence2"),
            ("Florence2|Florence2Run", "florence2"),
            ("DownloadAndLoadFlorence2Model", "florence2"),
            ("WD14Tagger|pysssss", "wd14"),
            ("WD14Tagger", "wd14"),
            ("Miaoshouai_Tagger", "miaoshouai"),
            ("JoyCaption", "joycaption"),
            ("BLIPCaption", "blip"),
        ]
        for node_name, method in i2t_candidates:
            if client.node_exists(node_name):
                self.i2t_method = method
                self.i2t_node = node_name
                break
        else:
            self.i2t_method = None
            self.i2t_node = None

    def pick_flux(self, prefer_9b=False):
        if prefer_9b and self.klein9b_unet:
            unet = self.klein9b_unet
        elif self.klein4b_unet:
            unet = self.klein4b_unet
        elif self.klein9b_unet:
            unet = self.klein9b_unet
        else:
            unet = next((f for f in self.flux_unets
                         if "klein" in f.lower() or "flux" in f.lower()),
                        self.flux_unets[0] if self.flux_unets else "")
        clip = next((c for c in self.flux_clips if "qwen" in c.lower()),
                    self.flux_clips[0] if self.flux_clips else "")
        vae  = next((v for v in self.flux_vaes if "flux" in v.lower()),
                    self.flux_vaes[0] if self.flux_vaes else "")
        return unet, clip, vae

    def character_sheet_mode(self):
        """Retorna o modo disponível: 'tripleview', 'spritesheet' ou None."""
        if self.klein9b_unet and (self.tripleview_lora or self.quadview_lora):
            return "tripleview"
        if self.klein4b_unet and self.spritesheet_lora:
            return "spritesheet"
        return None


