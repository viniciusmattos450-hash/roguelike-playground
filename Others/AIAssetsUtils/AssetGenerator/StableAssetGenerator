import importlib, subprocess, sys
REQUIRED = [("websocket", "websocket-client"), ("PIL", "Pillow"),
            ("requests", "requests"), ("huggingface_hub", "huggingface_hub")]

def _has(mod):
    try: importlib.import_module(mod); return True
    except ImportError: return False

def _ensure_dependencies():
    missing = [pip for mod, pip in REQUIRED if not _has(mod)]
    if not missing: return
    print("[i] Instalando:", ", ".join(missing))
    try:
        subprocess.check_call([sys.executable, "-m", "pip", "install", *missing])
    except subprocess.CalledProcessError:
        print("[!] Falha. Instale: pip install", " ".join(missing))
        input("ENTER..."); sys.exit(1)
    print("[+] Reiniciando...")
    subprocess.check_call([sys.executable] + sys.argv)
    sys.exit(0)

_ensure_dependencies()


