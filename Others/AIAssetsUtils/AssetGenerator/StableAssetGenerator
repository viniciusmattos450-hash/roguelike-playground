def wf_sdxl_txt2img(ckpt, pos, neg, w, h, batch, steps, seed, lora=None, lora_str=0.8, cfg=7.0):
    n = {
        "1": {"inputs": {"ckpt_name": ckpt}, "class_type": "CheckpointLoaderSimple"},
        "6": {"inputs": {"width": w, "height": h, "batch_size": batch}, "class_type": "EmptyLatentImage"},
        "7": {"inputs": {"seed": seed, "steps": steps, "cfg": cfg,
                         "sampler_name": "dpmpp_2m", "scheduler": "karras",
                         "denoise": 1.0, "model": ["1", 0], "positive": ["4", 0],
                         "negative": ["5", 0], "latent_image": ["6", 0]}, "class_type": "KSampler"},
        "8": {"inputs": {"samples": ["7", 0], "vae": ["1", 2]}, "class_type": "VAEDecode"},
        "9": {"inputs": {"images": ["8", 0]}, "class_type": "PreviewImage"},
    }
    if lora:
        n["2"] = {"inputs": {"model": ["1", 0], "clip": ["1", 1], "lora_name": lora,
                             "strength_model": lora_str, "strength_clip": lora_str},
                  "class_type": "LoraLoader"}
        ms, cs = ["2", 0], ["2", 1]
    else:
        ms, cs = ["1", 0], ["1", 1]
    n["4"] = {"inputs": {"text": pos, "clip": cs}, "class_type": "CLIPTextEncode"}
    n["5"] = {"inputs": {"text": neg, "clip": cs}, "class_type": "CLIPTextEncode"}
    n["7"]["inputs"]["model"] = ms
    return n

