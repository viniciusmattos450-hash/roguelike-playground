    def reload_presets(self):
        presets = self.app.presets.get(self.cat_key, {})
        values = list(presets.keys())
        self.cmb_preset["values"] = values
        current = self.var_preset.get()
        if current not in values:
            default = self.cfg.get("default_preset", "")
            if default in values:
                self.var_preset.set(default)
            elif values:
                self.var_preset.set(values[0])
            else:
                self.var_preset.set("")
        self._update_preset_hint()

    def _update_preset_hint(self):
        presets = self.app.presets.get(self.cat_key, {})
        suffix = presets.get(self.var_preset.get(), "")
        self.preset_hint.config(text=f"→ será anexado: {suffix.lstrip(', ')}")

    def on_models_refreshed(self):
        m = self.app.models
        if m.flux_ok:
            self.rb_flux.config(state=tk.NORMAL)
            if not self.var_flux_unet.get():
                u, c, v = m.pick_flux()
                self.var_flux_unet.set(u); self.var_flux_clip.set(c); self.var_flux_vae.set(v)
        if m.sdxl_ok:
            self.rb_sdxl.config(state=tk.NORMAL)
            if not self.var_sdxl_ckpt.get():
                self.var_sdxl_ckpt.set(m.ckpts[0])
        if m.flux_ok: self.var_engine.set("flux")
        elif m.sdxl_ok: self.var_engine.set("sdxl")
        self._on_engine_changed()
        if m.flux_ok or m.sdxl_ok:
            self.btn_generate.config(state=tk.NORMAL)

    def _on_engine_changed(self):
        for w in self.engine_frame.winfo_children(): w.destroy()
        m = self.app.models

        if self.var_engine.get() == "flux" and m.flux_ok:
            r = ttk.Frame(self.engine_frame); r.pack(fill=tk.X)
            ttk.Label(r, text="UNET:", width=8).pack(side=tk.LEFT)
            ttk.Combobox(r, textvariable=self.var_flux_unet,
