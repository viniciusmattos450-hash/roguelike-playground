    # ---------------------------------------------------------- modes
    def _refresh_modes(self):
        m = self.models
        modes = []
        if m.klein9b_unet and m.tripleview_lora:
            modes.append("TripleView (9B) — front/side/back")
        if m.klein9b_unet and m.quadview_lora:
            modes.append("QuadView (9B) — face + front/side/back")
        if m.klein4b_unet and m.spritesheet_lora:
            modes.append("Spritesheet 2x2 (4B) — objetos")

        self.cmb_mode["values"] = modes
        if modes:
            self.var_mode.set(modes[0])
            self.btn_generate.config(state=tk.NORMAL)
            self._on_mode_change()
            self.engine_label.config(text=f"✓ {len(modes)} modo(s) disponível(is)",
                                      foreground="green")
        else:
            self.var_mode.set("")
            self.btn_generate.config(state=tk.DISABLED)
            self.engine_label.config(
                text="✗ Nenhum combo instalado — clique em 'Instalar modelos'",
                foreground="red")
            self.prompt_entry.delete(0, tk.END)

    def _on_mode_change(self):
        mode = self.var_mode.get()
        if "TripleView" in mode:
            self.prompt_entry.delete(0, tk.END)
            self.prompt_entry.insert(0, TRIPLEVIEW_PROMPT)
            self.var_res.set("1536x1024")
            self.var_steps.set(8)
            self.var_denoise.set(0.90)
        elif "QuadView" in mode:
            self.prompt_entry.delete(0, tk.END)
            self.prompt_entry.insert(0, QUADVIEW_PROMPT)
            self.var_res.set("1536x1024")
            self.var_steps.set(8)
            self.var_denoise.set(0.90)
        elif "Spritesheet" in mode:
            self.prompt_entry.delete(0, tk.END)
            self.prompt_entry.insert(0, SPRITESHEET_PROMPT)
            self.var_res.set("1024x1024")
            self.var_steps.set(8)
            self.var_denoise.set(0.85)

    # ---------------------------------------------------------- concept
    def _load_concept(self):
        path = filedialog.askopenfilename(
            title="Selecione a imagem de concept",
            filetypes=[("Imagens", "*.png *.jpg *.jpeg *.webp"),
                       ("Todos", "*.*")])
        if not path: return
        try:
            with open(path, "rb") as f:
                data = f.read()
            self.concept_data = data
            img = Image.open(io.BytesIO(data))
            img.thumbnail((280, 280), Image.LANCZOS)
            self.concept_photo = ImageTk.PhotoImage(img)
            self.concept_label.config(image=self.concept_photo, text="",
                                       width=0, height=0)
            self.status.config(text=f"Concept: {os.path.basename(path)}",
                                foreground="green")
        except Exception as e:
            messagebox.showerror("Erro", f"Falha ao carregar:\n{e}")

    def _analyze_concept(self):
        if not self.concept_data or not self.models.i2t_method:
            return
        self.status.config(text="Analisando...", foreground="orange")
        threading.Thread(target=self._do_analyze, daemon=True).start()

    def _do_analyze(self):
        work = save_temp(self.concept_data, "concept")
        uploaded = self.client.upload_image(work)
        try: os.unlink(work)
        except: pass
        if not uploaded:
            self.after(0, lambda: self.status.config(
                text="Falha no upload.", foreground="red")); return

        wf = wf_img2txt(uploaded, self.models.i2t_method, self.models.i2t_node)
        res = self.client.queue(wf)
        if not res or "error" in res:
            self.after(0, lambda: self.status.config(
                text=f"Erro: {res}", foreground="red")); return
        pid = res["prompt_id"]
        ok, msg = self.client.wait_for(pid)
        if not ok:
            self.after(0, lambda: self.status.config(
                text=f"Erro: {msg}", foreground="red")); return

        hist = self.client.history(pid)
        text = self._extract_text(hist.get(pid, {}).get("outputs", {}))
        self.after(0, lambda t=text: self._apply_analysis(t))

    def _extract_text(self, outputs):
        candidates = []
        for node_out in outputs.values():
            for key, val in node_out.items():
                if isinstance(val, str) and val.strip():
                    candidates.append(val.strip())
                elif isinstance(val, list):
                    for item in val:
                        if isinstance(item, str) and item.strip():
                            candidates.append(item.strip())
        return max(candidates, key=len) if candidates else None

    def _apply_analysis(self, text):
        if not text:
            self.status.config(text="Nada retornado.", foreground="red"); return
        mode = self.var_mode.get()
        if "TripleView" in mode:
            base = TRIPLEVIEW_PROMPT
        elif "QuadView" in mode:
            base = QUADVIEW_PROMPT
        else:
            base = SPRITESHEET_PROMPT
        final = base + ". Character details: " + text
        self.prompt_entry.delete(0, tk.END)
        self.prompt_entry.insert(0, final)
        self.status.config(text="Prompt atualizado.", foreground="green")

    # ---------------------------------------------------------- geração
    def _generate(self):
        if not self.concept_data:
            messagebox.showwarning("Sem concept", "Carregue uma imagem."); return
        mode = self.var_mode.get()
        if not mode:
            messagebox.showerror("Sem modo",
                "Nenhum combo instalado. Clique em 'Instalar modelos'."); return
        self.btn_generate.config(state=tk.DISABLED)
        self.prog.config(value=0)
        self.status.config(text="Gerando reference sheet...", foreground="orange")
        threading.Thread(target=self._do_generate, daemon=True).start()

    def _do_generate(self):
        work = save_temp(self.concept_data, "concept")
        uploaded = self.client.upload_image(work)
        try: os.unlink(work)
        except: pass
        if not uploaded:
            self.after(0, lambda: self._done(None, "Falha no upload.")); return

        mode = self.var_mode.get()
        pos = self.prompt_entry.get().strip()
        neg = build_negative("")
        try:
            w, h = [int(x) for x in self.var_res.get().split("x")]
        except Exception:
            w, h = 1536, 1024
        steps = int(self.var_steps.get())
        denoise = float(self.var_denoise.get())
        lora_str = float(self.var_lora_str.get())
        seed = random.randint(1, 9_999_999_999)

        if "TripleView" in mode:
            lora = self.models.tripleview_lora
            unet, clip, vae = self.models.pick_flux(prefer_9b=True)
        elif "QuadView" in mode:
            lora = self.models.quadview_lora
            unet, clip, vae = self.models.pick_flux(prefer_9b=True)
        else:
            lora = self.models.spritesheet_lora
            unet, clip, vae = self.models.pick_flux(prefer_9b=False)

        wf = wf_flux_img2img(unet, clip, vae, uploaded, pos, neg,
                              1.0, steps, denoise, seed,
                              lora=lora, lora_str=lora_str)

        res = self.client.queue(wf)
        if not res or "prompt_id" not in res or "error" in res:
            self.after(0, lambda e=res: self._done(None, f"Erro: {e}")); return
        pid = res["prompt_id"]

        def cb(v, m):
            pct = int(100 * v/max(1, m))
            self.after(0, lambda p=pct: self.prog.config(value=p))

        ok, msg = self.client.wait_for(pid, on_progress=cb)
        if not ok:
            self.after(0, lambda m=msg: self._done(None, f"Erro: {m}")); return

        hist = self.client.history(pid)
        data = None
        for node in hist.get(pid, {}).get("outputs", {}).values():
            if "images" in node:
                for info in node["images"]:
                    data = self.client.fetch_image(
                        info["filename"], info.get("subfolder", ""),
                        info.get("type", "temp"))
                    break
            if data: break

        self.after(0, lambda d=data: self._done(d, None))

    def _done(self, data, error):
        self.btn_generate.config(state=tk.NORMAL)
        self.prog.config(value=100)
        if error:
            self.status.config(text=error, foreground="red")
            messagebox.showerror("Erro", error); return

        self.result_data = data
        img = Image.open(io.BytesIO(data))
        w, h = img.size
        disp = img.copy()
        disp.thumbnail((720, 620), Image.LANCZOS)
        photo = ImageTk.PhotoImage(disp)
        self.result_photo = photo
        self.result_label.config(image=photo, text="", width=0, height=0)
        self.status.config(text=f"Reference Sheet gerado ({w}×{h}px).",
                            foreground="green")

    def _preview_result(self):
        if not self.result_data: return
        actions = [("Salvar em pasta", self._save_result)]
        PreviewWindow(self, "Reference Sheet", self.result_data, actions)

    def _save_result(self):
        if not self.result_data:
            messagebox.showinfo("Vazio", "Nada para salvar."); return
        char_name = self.var_name.get().strip() or "character"
        safe = "".join(c if c.isalnum() or c in "-_" else "_"
                       for c in char_name)[:40] or "character"
        char_dir = os.path.join(CHARS_DIR, safe)
        os.makedirs(char_dir, exist_ok=True)
        sheet_path = os.path.join(char_dir, "reference_sheet.png")
        with open(sheet_path, "wb") as f:
            f.write(self.result_data)
        messagebox.showinfo("Salvo", f"Salvo em:\n{sheet_path}")

    def _split_views(self):
        if not self.result_data:
            messagebox.showinfo("Vazio", "Gere o sheet primeiro."); return

        mode = self.var_mode.get()
        img = Image.open(io.BytesIO(self.result_data))
        w, h = img.size

        char_name = self.var_name.get().strip() or "character"
        safe = "".join(c if c.isalnum() or c in "-_" else "_"
                       for c in char_name)[:40] or "character"
        char_dir = os.path.join(CHARS_DIR, safe)
        os.makedirs(char_dir, exist_ok=True)

        if "Spritesheet" in mode:
            # 2x2 grid
            names = [("top_left", 0, 0), ("top_right", 0, 1),
                     ("bottom_left", 1, 0), ("bottom_right", 1, 1)]
            cw, ch = w // 2, h // 2
            for name, r, c in names:
                crop = img.crop((c*cw, r*ch, (c+1)*cw, (r+1)*ch))
                crop.save(os.path.join(char_dir, f"{name}.png"))
        elif "QuadView" in mode:
            # 2x2
            names = [("face", 0, 0), ("front", 0, 1),
                     ("side", 1, 0), ("back", 1, 1)]
            cw, ch = w // 2, h // 2
            for name, r, c in names:
                crop = img.crop((c*cw, r*ch, (c+1)*cw, (r+1)*ch))
                crop.save(os.path.join(char_dir, f"{name}.png"))
        else:
            # TripleView: 3 colunas
            names = ["front", "side", "back"]
            cw = w // 3
            for i, name in enumerate(names):
                x0 = i * cw
                x1 = (i+1) * cw if i < 2 else w
                crop = img.crop((x0, 0, x1, h))
                crop.save(os.path.join(char_dir, f"{name}.png"))

        messagebox.showinfo("Views separadas",
            f"Views salvas em:\n{char_dir}")

    def _load_existing(self):
        char_name = self.var_name.get().strip() or "character"
        safe = "".join(c if c.isalnum() or c in "-_" else "_"
                       for c in char_name)[:40] or "character"
        char_dir = os.path.join(CHARS_DIR, safe)
        sheet_path = os.path.join(char_dir, "reference_sheet.png")
        if not os.path.isfile(sheet_path):
            messagebox.showinfo("Não existe",
                f"Não há reference_sheet.png em {char_dir}"); return
        try:
            with open(sheet_path, "rb") as f:
                data = f.read()
            self.result_data = data
            img = Image.open(io.BytesIO(data))
            disp = img.copy(); disp.thumbnail((720, 620), Image.LANCZOS)
            photo = ImageTk.PhotoImage(disp)
            self.result_photo = photo
            self.result_label.config(image=photo, text="", width=0, height=0)
            self.status.config(text="Sheet carregado do disco.", foreground="green")
        except Exception as e:
            messagebox.showerror("Erro", f"Falha: {e}")


