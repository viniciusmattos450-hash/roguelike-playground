def load_presets():
    defaults = {k: dict(v["presets"]) for k, v in CATEGORIES.items()}
    if not os.path.exists(PRESETS_FILE):
        return defaults
    try:
        with open(PRESETS_FILE, "r", encoding="utf-8") as f:
            loaded = json.load(f)
        for cat_key, presets in loaded.items():
            if cat_key in defaults and isinstance(presets, dict):
                defaults[cat_key] = dict(presets)
        return defaults
    except Exception as e:
        print(f"[!] presets.json corrompido: {e}")
        return defaults


def save_presets(presets):
    try:
        with open(PRESETS_FILE, "w", encoding="utf-8") as f:
            json.dump(presets, f, indent=2, ensure_ascii=False)
        return True
    except Exception as e:
        print(f"[!] Erro ao salvar presets: {e}")
        return False


