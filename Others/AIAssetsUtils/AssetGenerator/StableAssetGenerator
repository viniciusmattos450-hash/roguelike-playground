def clear_temp_dir():
    if not os.path.isdir(TEMP_DIR): return
    for f in os.listdir(TEMP_DIR):
        p = os.path.join(TEMP_DIR, f)
        try:
            if os.path.isfile(p): os.unlink(p)
            elif os.path.isdir(p): shutil.rmtree(p, ignore_errors=True)
        except Exception: pass

def folder_count(path):
    try: return len([f for f in os.listdir(path)
                     if os.path.isfile(os.path.join(path, f))])
    except Exception: return 0

def unique_asset_path(base_name, suffix):
    ts = time.strftime("%Y%m%d_%H%M%S")
    safe = "".join(c if c.isalnum() or c in "-_" else "_"
                   for c in base_name.strip())[:40] or "asset"
    return os.path.join(ASSETS_DIR, f"{safe}_{ts}_{suffix}.png")

def save_temp(data, prefix):
    ts = time.strftime("%H%M%S")
    path = os.path.join(TEMP_DIR, f"{prefix}_{ts}_{uuid.uuid4().hex[:6]}.png")
    with open(path, "wb") as f: f.write(data)
    return path


