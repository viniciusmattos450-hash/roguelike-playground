    def _on_generate(self):
        if not self.prompt_entry.get().strip():
            messagebox.showwarning("Prompt vazio", "Digite o nome do objeto."); return
        clear_temp_dir()
        self.generated.clear()
        self._display_gallery()
        self.btn_generate.config(state=tk.DISABLED)
        self.prog.config(value=0)
        self.app.set_status("Gerando variações...", "orange")
        threading.Thread(target=self._do_generate, daemon=True).start()

    def _do_generate(self):
        presets = self.app.presets.get(self.cat_key, {})
        pos = build_positive(self.prompt_entry.get(),
                              presets.get(self.var_preset.get(), ""))
        neg = build_negative(self.neg_entry.get())
        w = h = int(self.var_res.get())
        batch = int(self.var_count.get())
        steps = int(self.var_steps.get())

        results = []
        for i in range(batch):
            self.after(0, lambda i=i, b=batch: self.app.set_status(
                f"Gerando item {i+1}/{b}...", "orange"))
            seed = random.randint(1, 9_999_999_999)
            if self.var_engine.get() == "flux":
                wf = wf_flux_txt2img(self.var_flux_unet.get(),
                                      self.var_flux_clip.get(),
                                      self.var_flux_vae.get(),
                                      pos, neg, w, h, 1, steps, seed)
            else:
                lora = self.var_sdxl_lora.get()
                if lora == "<nenhum>": lora = None
                wf = wf_sdxl_txt2img(self.var_sdxl_ckpt.get(), pos, neg,
                                      w, h, 1, steps, seed, lora,
                                      float(self.var_sdxl_lora_str.get()))
            res = self.app.client.queue(wf)
            if not res or "prompt_id" not in res or "error" in res:
                self.after(0, lambda e=res: self.app.err(f"Erro: {e}")); return
            pid = res["prompt_id"]

            def cb(v, mm, base=i, tot=batch):
                pct = int(100 * (base + v/max(1, mm)) / tot)
                self.after(0, lambda p=pct: self.prog.config(value=p))

            ok, msg = self.app.client.wait_for(pid, on_progress=cb)
            if not ok:
                self.after(0, lambda m=msg: self.app.err(f"Erro: {m}")); return

            hist = self.app.client.history(pid)
            for node in hist.get(pid, {}).get("outputs", {}).values():
                if "images" in node:
                    for info in node["images"]:
                        data = self.app.client.fetch_image(info["filename"],
                            info.get("subfolder", ""), info.get("type", "temp"))
                        local = save_temp(data, "gen")
                        results.append({"data": data, "local_path": local})

        self.after(0, lambda: self.prog.config(value=100))
        base_name = self.prompt_entry.get().strip()
        self.generated = []
        for r in results:
            thumb = Image.open(io.BytesIO(r["data"]))
            thumb.thumbnail((THUMB_SIZE, THUMB_SIZE), Image.LANCZOS)
            self.generated.append({"photo": ImageTk.PhotoImage(thumb),
                                    "data": r["data"],
                                    "local_path": r["local_path"],
                                    "base_name": base_name})
        self.after(0, self._display_gallery)
        self.after(0, lambda: self.app.set_status(
            f"{len(self.generated)} variações.", "green"))
        self.after(0, self.app.refresh_folders)
        self.after(0, lambda: self.btn_generate.config(state=tk.NORMAL))

    def _display_gallery(self):
        for w in self.gal_inner.winfo_children(): w.destroy()
        if not self.generated:
            ttk.Label(self.gal_inner, text="Nenhuma imagem ainda.",
                      foreground="#777").pack(pady=20); return
        cols = 4
        for i, item in enumerate(self.generated):
            cell = ttk.Frame(self.gal_inner, padding=4)
            cell.grid(row=i//cols, column=i%cols, padx=4, pady=4)
            lbl = tk.Label(cell, image=item["photo"], cursor="hand2",
                           borderwidth=2, relief="flat")
            lbl.pack()
            lbl.bind("<Button-1>", lambda e, idx=i: self._preview_gal(idx))
            ttk.Label(cell, text=f"#{i+1}", foreground="#666").pack()

    def _preview_gal(self, idx):
        item = self.generated[idx]
        actions = [
            ("Editar esta", lambda: self._open_edit(idx)),
            ("Salvar em assets/", lambda: self._save_gal(idx)),
        ]
        PreviewWindow(self, f"Variação #{idx+1}", item["data"], actions)

    def _save_gal(self, idx):
        path = unique_asset_path(self.generated[idx]["base_name"], "original")
        with open(path, "wb") as f: f.write(self.generated[idx]["data"])
        messagebox.showinfo("Salvo", f"Salvo em:\n{path}")
        self.app.refresh_folders()

    def _open_edit(self, idx):
        try:
            EditWindow(self, self.generated[idx])
        except Exception as e:
            import traceback
            traceback.print_exc()
            messagebox.showerror("Erro ao abrir editor", f"{e}")


