    def _on_img2txt(self):
        if not self.models.i2t_method:
            messagebox.showerror("Indisponível",
                "Nenhum modelo de Image-to-Text detectado."); return
        self.btn_i2t.config(state=tk.DISABLED)
        self.prog.config(value=0)
        self.status.config(text="Analisando imagem...", foreground="orange")
        threading.Thread(target=self._do_img2txt, daemon=True).start()

    def _do_img2txt(self):
        work = save_temp(self.current_data, "i2t_src")
        uploaded = self.client.upload_image(work)
        try: os.unlink(work)
        except: pass
        if not uploaded:
            self.after(0, lambda: self._i2t_done(None, "Falha no upload.")); return

        wf = wf_img2txt(uploaded, self.models.i2t_method, self.models.i2t_node)
        res = self.client.queue(wf)
        if not res or "prompt_id" not in res or "error" in res:
            self.after(0, lambda e=res: self._i2t_done(None, f"Erro: {e}")); return
        pid = res["prompt_id"]

        ok, msg = self.client.wait_for(pid)
        if not ok:
            self.after(0, lambda m=msg: self._i2t_done(None, f"Erro: {m}")); return

        hist = self.client.history(pid)
        text = self._extract_text(hist.get(pid, {}).get("outputs", {}))
        self.after(0, lambda t=text: self._i2t_done(t, None))

    def _extract_text(self, outputs):
        candidates = []
        for node_out in outputs.values():
            for key, val in node_out.items():
                if isinstance(val, str) and val.strip():
                    candidates.append(val.strip())
                elif isinstance(val, list):
                    for item in val:
                        if isinstance(item, str) and item.strip():
                            candidates.append(item.strip())
        return max(candidates, key=len) if candidates else None

    def _i2t_done(self, text, error):
        self.btn_i2t.config(state=tk.NORMAL)
        self.prog.config(value=100)
        if error:
            self.status.config(text=error, foreground="red")
            messagebox.showerror("Erro", error); return
        if not text:
            self.status.config(text="Nada retornado.", foreground="red")
            messagebox.showerror("Erro", "O modelo não retornou texto."); return
        self._show_text_dialog(text)

    def _show_text_dialog(self, text):
        win = tk.Toplevel(self); win.title("Texto extraído")
        win.geometry("640x400")
        win.minsize(520, 320)

        ttk.Label(win, text="Descrição da imagem:",
                  font=("Segoe UI", 10, "bold")).pack(anchor="w", padx=10, pady=(10, 4))
        txt = tk.Text(win, wrap="word", height=12)
        txt.pack(fill=tk.BOTH, expand=True, padx=10)
        txt.insert("1.0", text)

        def _substituir():
            self.prompt_entry.delete(0, tk.END)
            self.prompt_entry.insert(0, text)
            win.destroy()

        def _adicionar():
            cur = self.prompt_entry.get().strip()
            self.prompt_entry.delete(0, tk.END)
            self.prompt_entry.insert(0, (cur + ", " + text) if cur else text)
            win.destroy()

        btn_bar = ttk.Frame(win); btn_bar.pack(pady=10)
        ttk.Button(btn_bar, text="Substituir prompt",
                   command=_substituir).pack(side=tk.LEFT, padx=4)
        ttk.Button(btn_bar, text="Adicionar ao prompt",
                   command=_adicionar).pack(side=tk.LEFT, padx=4)
        ttk.Button(btn_bar, text="Fechar", command=win.destroy).pack(side=tk.LEFT, padx=4)

    def _on_generate(self):
        do_scale = self.var_do_scale.get()
        do_edit = self.var_do_edit.get()
        do_detail = self.var_do_detail.get()
        if not (do_scale or do_edit or do_detail):
            messagebox.showwarning("Nada selecionado",
                "Marque ao menos uma operação."); return
        if self.var_engine.get() == "sdxl" and not self.models.sdxl_ok and (do_edit or do_detail):
            messagebox.showerror("SDXL indisponível", "Nenhum checkpoint."); return
        if self.var_engine.get() == "flux" and not self.models.flux_ok and (do_edit or do_detail):
            messagebox.showerror("Flux indisponível", "GGUFs não encontrados."); return
        self.btn_gen.config(state=tk.DISABLED)
        self.prog.config(value=0)
        self.status.config(text="Preparando...", foreground="orange")
        threading.Thread(target=self._do_generate, daemon=True).start()

    def _do_generate(self):
        do_scale = self.var_do_scale.get()
        do_edit = self.var_do_edit.get()
        do_detail = self.var_do_detail.get()

        work_file = save_temp(self.current_data, "work")
        uploaded = self.client.upload_image(work_file)
        try: os.unlink(work_file)
        except: pass
        if not uploaded:
            self.after(0, lambda: self._err("Falha no upload.")); return

        batch = int(self.var_batch.get())
        steps = int(self.var_steps.get())
        pos = build_positive(self.prompt_entry.get(), self.preset_suffix)
        neg = build_negative("")

        if do_detail:
            pos += DETAIL_BOOST

        if do_edit and not do_detail:
            denoise = float(self.var_denoise.get())
        elif do_detail and not do_edit:
            denoise = 0.30
        elif do_edit and do_detail:
            denoise = max(0.30, float(self.var_denoise.get()) * 0.75)
        else:
            denoise = 1.0

        if do_scale:
            scale = float(self.var_scale.get())
        else:
            scale = 1.0

        up_model = self.var_upscale_model.get()
        if up_model == "<lanczos>":
            up_model = None

        only_scale = do_scale and not (do_edit or do_detail)

        results = []
        for i in range(batch):
            self.after(0, lambda i=i, b=batch: self.status.config(
                text=f"Item {i+1}/{b}...", foreground="orange"))
            seed = random.randint(1, 9_999_999_999)

            if only_scale:
                if up_model:
                    wf = wf_upscale_with_model(uploaded, up_model)
                else:
                    wf = wf_scale_only(uploaded, scale)
            else:
                if self.var_engine.get() == "flux":
                    wf = wf_flux_img2img(self.snap_flux_unet, self.snap_flux_clip,
                                          self.snap_flux_vae, uploaded,
                                          pos, neg, scale, steps, denoise, seed,
                                          upscale_model=up_model if do_scale else None)
                else:
                    lora = self.snap_sdxl_lora
                    if lora == "<nenhum>": lora = None
                    wf = wf_sdxl_img2img(self.snap_sdxl_ckpt, uploaded, pos, neg,
                                          scale, steps, denoise, seed,
                                          lora, self.snap_sdxl_lora_str,
                                          upscale_model=up_model if do_scale else None)

            res = self.client.queue(wf)
            if not res or "prompt_id" not in res or "error" in res:
                self.after(0, lambda e=res: self._err(f"Erro: {e}")); return
            pid = res["prompt_id"]

            def cb(v, m, base=i, tot=batch):
                pct = int(100 * (base + v/max(1, m)) / tot)
                self.after(0, lambda p=pct: self.prog.config(value=p))

            ok, msg = self.client.wait_for(pid, on_progress=cb)
            if not ok:
                self.after(0, lambda m=msg: self._err(f"Erro: {m}")); return

            hist = self.client.history(pid)
            for node in hist.get(pid, {}).get("outputs", {}).values():
                if "images" in node:
                    for info in node["images"]:
                        data = self.client.fetch_image(info["filename"],
                            info.get("subfolder", ""), info.get("type", "temp"))
                        local = save_temp(data, "op")
                        results.append({"data": data, "local_path": local})

        self.after(0, lambda: self.prog.config(value=100))

        for r in results:
            thumb = Image.open(io.BytesIO(r["data"]))
            thumb.thumbnail((THUMB_SIZE, THUMB_SIZE), Image.LANCZOS)
            self.results.append({"photo": ImageTk.PhotoImage(thumb),
                                  "data": r["data"],
                                  "local_path": r["local_path"]})

        self.after(0, self._display_results)
        self.after(0, lambda: self.status.config(
            text=f"{len(results)} novos resultados.", foreground="green"))
        self.after(0, lambda: self.btn_gen.config(state=tk.NORMAL))
        self.after(0, self.app.refresh_folders)

    def _on_remove_bg(self):
        if not self.models.has_rmbg or not self.models.rmbg_models:
            messagebox.showerror("Sem RMBG", "Node RMBG indisponível."); return
        self.btn_rmbg.config(state=tk.DISABLED)
        self.prog.config(value=0)
        self.status.config(text="Removendo fundo...", foreground="orange")
        threading.Thread(target=self._do_remove_bg, daemon=True).start()

    def _do_remove_bg(self):
        work_file = save_temp(self.current_data, "rmbg_src")
        uploaded = self.client.upload_image(work_file)
        try: os.unlink(work_file)
        except: pass
        if not uploaded:
            self.after(0, lambda: self._rmbg_done(None, "Falha no upload.")); return

        model_name = self.models.rmbg_models[0]
        wf = wf_remove_bg_rmbg(model_name, uploaded)
        res = self.client.queue(wf)
        if not res or "prompt_id" not in res or "error" in res:
            self.after(0, lambda e=res: self._rmbg_done(None, f"Erro: {e}")); return
        pid = res["prompt_id"]

        def cb(v, m):
            pct = int(100 * v/max(1, m))
            self.after(0, lambda p=pct: self.prog.config(value=p))

        ok, msg = self.client.wait_for(pid, on_progress=cb)
        if not ok:
            self.after(0, lambda m=msg: self._rmbg_done(None, f"Erro: {m}")); return

        hist = self.client.history(pid)
        result_bytes = None
        for node in hist.get(pid, {}).get("outputs", {}).values():
            if "images" in node:
                for info in node["images"]:
                    result_bytes = self.client.fetch_image(
                        info["filename"], info.get("subfolder", ""),
                        info.get("type", "temp"))
        if result_bytes is None:
            self.after(0, lambda: self._rmbg_done(None, "Sem imagem.")); return
        self.after(0, lambda d=result_bytes: self._rmbg_done(d, None))

    def _rmbg_done(self, result_bytes, error):
        self.btn_rmbg.config(state=tk.NORMAL)
        self.prog.config(value=100)
        if error:
            self.status.config(text=error, foreground="red")
            messagebox.showerror("Erro", error); return

        thumb = Image.open(io.BytesIO(result_bytes)).convert("RGBA")
        thumb.thumbnail((THUMB_SIZE, THUMB_SIZE), Image.LANCZOS)
        bg = Image.new("RGBA", thumb.size, (40, 40, 40, 255))
        bg.paste(thumb, (0, 0), thumb)
        self.results.append({
            "photo": ImageTk.PhotoImage(bg),
            "data": result_bytes,
            "local_path": save_temp(result_bytes, "rmbg"),
        })
        self._display_results()
        self.status.config(text="Fundo removido.", foreground="green")
        self.app.refresh_folders()

    def _display_results(self):
        for w in self.res_inner.winfo_children(): w.destroy()
        if not self.results:
            ttk.Label(self.res_inner, text="Sem resultados ainda.",
                      foreground="#777").pack(pady=20); return
        cols = 5
        for i, r in enumerate(self.results):
            cell = ttk.Frame(self.res_inner, padding=3)
            cell.grid(row=i//cols, column=i%cols, padx=3, pady=3)
            lbl = tk.Label(cell, image=r["photo"], cursor="hand2",
                           borderwidth=2, relief="flat")
            lbl.pack()
            lbl.bind("<Button-1>", lambda e, idx=i: self._preview_result(idx))
            ttk.Label(cell, text=f"#{i+1}", foreground="#666").pack()

    def _preview_result(self, idx):
        r = self.results[idx]
        actions = [
            ("Definir como principal", lambda: self._set_main_from_result(idx)),
            ("Salvar em assets/", lambda: self._save_result(idx)),
        ]
        PreviewWindow(self, f"Resultado #{idx+1}", r["data"], actions)

    def _save_result(self, idx):
        r = self.results[idx]
        parts = []
        if self.var_do_scale.get(): parts.append("upscaled")
        if self.var_do_edit.get():  parts.append("edited")
        if self.var_do_detail.get(): parts.append("detailed")
        suffix = "_".join(parts) if parts else "result"
        path = unique_asset_path(self.item["base_name"], suffix)
        with open(path, "wb") as f: f.write(r["data"])
        messagebox.showinfo("Salvo", f"Salvo em:\n{path}")
        self.app.refresh_folders()

    def _set_main_from_result(self, idx):
        self.current_data = self.results[idx]["data"]
        self._refresh_main()

    def _on_save_original(self):
        path = unique_asset_path(self.item["base_name"], "original")
        with open(path, "wb") as f: f.write(self.original_data)
        messagebox.showinfo("Salvo", f"Original salva em:\n{path}")
        self.app.refresh_folders()
        self.destroy()

    def _clear_and_reset(self):
        self.results = []
        self._display_results()
        clear_temp_dir()
        self.app.refresh_folders()
        self.status.config(text="Resultados limpos.", foreground="#333")

    def _err(self, msg):
        self.status.config(text=msg, foreground="red")
        self.btn_gen.config(state=tk.NORMAL)
        messagebox.showerror("Erro", msg)


# ====================================================================
#  APP
# ====================================================================
class App(tk.Tk):
    def __init__(self):
        super().__init__()
        self.title("Asset Creator — v1.1")
        self.geometry("1180x920")
        self.minsize(1000, 760)

        self.client = ComfyClient(COMFY_SERVER)
        self.models = Models()
        self.presets = load_presets()
        self.tabs = {}

        self._build_ui()
        atexit.register(clear_temp_dir)
        self.protocol("WM_DELETE_WINDOW", self._on_close)
        self.after(200, self._boot)

    def _build_ui(self):
        root = ttk.Frame(self, padding=8)
        root.pack(fill=tk.BOTH, expand=True)

        h = ttk.Frame(root); h.pack(fill=tk.X, pady=(0, 6))
        ttk.Label(h, text="Asset Creator",
                  font=("Segoe UI", 15, "bold")).pack(side=tk.LEFT)
        ttk.Button(h, text="🧙 Character Sheet",
                   command=self.open_character_sheet).pack(side=tk.LEFT, padx=12)
        ttk.Button(h, text="⚙ Settings",
                   command=self.open_settings).pack(side=tk.LEFT, padx=4)
        ttk.Button(h, text="⬇ Baixar modelos",
                   command=self.open_download_dialog).pack(side=tk.LEFT, padx=4)
        self.conn_label = ttk.Label(h, text="● Conectando...", foreground="orange")
        self.conn_label.pack(side=tk.RIGHT)

        req = ttk.LabelFrame(root, text="Requisitos detectados", padding=6)
        req.pack(fill=tk.X, pady=(0, 6))
        self.req_flux = ttk.Label(req, text="Flux Klein: verificando...", foreground="#666")
        self.req_flux.pack(anchor="w")
        self.req_sdxl = ttk.Label(req, text="SDXL: verificando...", foreground="#666")
        self.req_sdxl.pack(anchor="w")
        self.req_charsheet = ttk.Label(req, text="Character Sheet: verificando...", foreground="#666")
        self.req_charsheet.pack(anchor="w")
        self.req_rmbg = ttk.Label(req, text="RMBG: verificando...", foreground="#666")
        self.req_rmbg.pack(anchor="w")
        self.req_i2t = ttk.Label(req, text="Image-to-text: verificando...", foreground="#666")
        self.req_i2t.pack(anchor="w")
        self.req_upscale = ttk.Label(req, text="Upscale: verificando...", foreground="#666")
        self.req_upscale.pack(anchor="w")

        self.notebook = ttk.Notebook(root)
        self.notebook.pack(fill=tk.BOTH, expand=True)

        for key, cfg in CATEGORIES.items():
            tab = CategoryTab(self.notebook, self, key)
            self.notebook.add(tab, text=cfg["title"])
            self.tabs[key] = tab

        st = ttk.Frame(root); st.pack(fill=tk.X, pady=(6, 0))
        self.status = ttk.Label(st, text="Pronto.", foreground="#333")
        self.status.pack(side=tk.LEFT)
        self.folders_label = ttk.Label(st, text="", foreground="#666")
        self.folders_label.pack(side=tk.RIGHT)
        self.refresh_folders()

    def set_status(self, text, color="black"):
        self.status.config(text=text, foreground=color)

    def err(self, msg):
        self.set_status(msg, "red")
        messagebox.showerror("Erro", msg)

    def refresh_folders(self):
        n_chars = 0
        if os.path.isdir(CHARS_DIR):
            n_chars = len([d for d in os.listdir(CHARS_DIR)
                           if os.path.isdir(os.path.join(CHARS_DIR, d))])
        self.folders_label.config(
            text=f"temp/: {folder_count(TEMP_DIR)}   assets/: {folder_count(ASSETS_DIR)}   chars/: {n_chars}")

    def open_settings(self):
        SettingsDialog(self, self)

    def open_download_dialog(self):
        DownloadDialog(self, self)

    def open_character_sheet(self):
        CharacterSheetGenerator(self, self)

    def reload_models(self):
        self.models.refresh(self.client)
        self._update_req_panel()
        for tab in self.tabs.values():
            tab.on_models_refreshed()

    def _update_req_panel(self):
        m = self.models
        if m.flux_ok:
            self.req_flux.config(
                text=f"Flux Klein: OK ({len(m.flux_unets)} unet)", foreground="green")
        else:
            self.req_flux.config(text="Flux Klein: INDISPONÍVEL", foreground="red")

        if m.sdxl_ok:
            self.req_sdxl.config(
                text=f"SDXL: OK ({len(m.ckpts)} checkpoints, "
                     f"{len(m.loras)} LoRAs)", foreground="green")
        else:
            self.req_sdxl.config(text="SDXL: INDISPONÍVEL", foreground="red")

        # Character Sheet status
        mode = m.character_sheet_mode()
        if mode == "tripleview":
            self.req_charsheet.config(
                text=f"Character Sheet: OK (Klein 9B + TripleView/QuadView)",
                foreground="green")
        elif mode == "spritesheet":
            self.req_charsheet.config(
                text=f"Character Sheet: OK (Klein 4B + Spritesheet)",
                foreground="green")
        else:
            self.req_charsheet.config(
                text="Character Sheet: INDISPONÍVEL — instale na aba 'Character Sheet'",
                foreground="red")

        if m.has_rmbg and m.rmbg_models:
            self.req_rmbg.config(
                text=f"RMBG: OK ({len(m.rmbg_models)} modelos)", foreground="green")
        else:
            self.req_rmbg.config(text="RMBG: INDISPONÍVEL", foreground="red")

        if m.i2t_method:
            self.req_i2t.config(
                text=f"Image-to-text: OK ({m.i2t_method} via {m.i2t_node})",
                foreground="green")
        else:
            self.req_i2t.config(
                text="Image-to-text: INDISPONÍVEL — instale Florence2 ou WD14 Tagger",
                foreground="red")

        if m.upscale_models:
            short = ", ".join(m.upscale_models[:3])
            if len(m.upscale_models) > 3:
                short += f" (+{len(m.upscale_models)-3})"
            self.req_upscale.config(
                text=f"Upscale: OK ({len(m.upscale_models)} modelos: {short})",
                foreground="green")
        else:
            self.req_upscale.config(
                text="Upscale: NENHUM — clique em '⬇ Baixar modelos'",
                foreground="orange")

    def _boot(self):
        if not self.client.is_alive():
            self.conn_label.config(text="● ComfyUI offline (127.0.0.1:8188)",
                                    foreground="red")
            self.after(3000, self._boot); return

        self.conn_label.config(text="● ComfyUI conectado", foreground="green")
        self.client.connect_ws()
        self.models.refresh(self.client)
        self._update_req_panel()

        for tab in self.tabs.values():
            tab.on_models_refreshed()

        self.refresh_folders()

    def _on_close(self):
        clear_temp_dir()
        try:
            save_presets(self.presets)
        except Exception:
            pass
        self.destroy()


