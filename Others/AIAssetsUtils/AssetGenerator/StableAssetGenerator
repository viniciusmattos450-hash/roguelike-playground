def find_comfyui_dir():
    candidates = []
    for env in ("COMFYUI_PATH", "COMFYUI_DIR", "COMFY_PATH"):
        p = os.environ.get(env)
        if p and os.path.isdir(p):
            candidates.append(p)

    home = os.path.expanduser("~")
    for base in (home, os.path.join(home, "Documents"),
                 os.path.join(home, "Desktop"),
                 os.path.join(home, "OneDrive"), "C:\\", "D:\\"):
        if not os.path.isdir(base):
            continue
        try:
            for root, dirs, files in os.walk(base):
                depth = root[len(base):].count(os.sep)
                if depth > 4:
                    dirs[:] = []
                    continue
                if os.path.basename(root) == "ComfyUI":
                    if os.path.isdir(os.path.join(root, "models")):
                        candidates.append(root)
        except Exception:
            pass

    local_models = os.path.join(SCRIPT_DIR, "models")
    if os.path.isdir(local_models):
        candidates.append(SCRIPT_DIR)

    for c in candidates:
        if os.path.isdir(os.path.join(c, "models")):
            return c
    return None


def get_models_dir(comfy_dir=None, target="upscale_models"):
    if comfy_dir is None:
        comfy_dir = find_comfyui_dir()
    if not comfy_dir:
        return None
    d = os.path.join(comfy_dir, "models", target)
    try:
        os.makedirs(d, exist_ok=True)
    except Exception:
        return None
    return d


