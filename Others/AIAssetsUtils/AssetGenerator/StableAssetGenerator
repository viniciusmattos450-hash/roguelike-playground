# ====================================================================
class DownloadDialog(tk.Toplevel):
    def __init__(self, parent, app):
        super().__init__(parent)
        self.app = app
        self.title("Baixar modelos")
        self.geometry("820x680")
        self.minsize(720, 560)
        self.resizable(True, True)

        self._build_ui()
        self._check_existing()

    def _build_ui(self):
        root = ttk.Frame(self, padding=10)
        root.pack(fill=tk.BOTH, expand=True)

        ttk.Label(root, text="Modelos disponíveis",
                  font=("Segoe UI", 13, "bold")).pack(anchor="w")
        ttk.Label(root,
                  text="Modelos grandes (~5 GB) requerem espaço em disco. "
                       "Reinicie o ComfyUI após o download.",
                  foreground="#666", wraplength=740, justify="left"
                  ).pack(anchor="w", pady=(0, 10))

        dest_frame = ttk.LabelFrame(root, text="Pasta raiz do ComfyUI", padding=6)
        dest_frame.pack(fill=tk.X, pady=(0, 10))
        self.var_dest = tk.StringVar()
        ttk.Entry(dest_frame, textvariable=self.var_dest, state="readonly"
                  ).pack(side=tk.LEFT, fill=tk.X, expand=True)
        ttk.Button(dest_frame, text="Alterar...",
                   command=self._pick_folder).pack(side=tk.LEFT, padx=4)

        nb = ttk.Notebook(root)
        nb.pack(fill=tk.BOTH, expand=True)

        self.var_checks = {}
        for category, models in DOWNLOADS.items():
            tab = ttk.Frame(nb, padding=6)
            nb.add(tab, text=category)
            for key, info in models.items():
                row = ttk.Frame(tab)
                row.pack(fill=tk.X, pady=3)
                v = tk.BooleanVar(value=False)
                self.var_checks[key] = v
                ttk.Checkbutton(row, variable=v).pack(side=tk.LEFT)
                ttk.Label(row, text=info["display"], width=58, anchor="w"
                          ).pack(side=tk.LEFT, padx=4)
                ttk.Label(row, text=f"~{info['size_mb']} MB",
                          foreground="#666").pack(side=tk.LEFT)
                ttk.Label(row, text=f"→ {info['target']}/",
                          foreground="#888", font=("Segoe UI", 8, "italic")
                          ).pack(side=tk.LEFT, padx=8)

        prog_frame = ttk.Frame(root); prog_frame.pack(fill=tk.X, pady=(10, 4))
        self.prog = ttk.Progressbar(prog_frame, mode="determinate", maximum=100)
        self.prog.pack(fill=tk.X)
        self.status = ttk.Label(prog_frame, text="Pronto.", foreground="#666")
        self.status.pack(anchor="w", pady=(2, 0))

        btn_bar = ttk.Frame(root); btn_bar.pack(fill=tk.X, pady=(6, 0))
        self.btn_download = ttk.Button(btn_bar, text="Baixar selecionados",
                                        command=self._on_download)
        self.btn_download.pack(side=tk.LEFT)
        ttk.Button(btn_bar, text="Fechar", command=self.destroy).pack(side=tk.RIGHT)

    def _check_existing(self):
        comfy_dir = find_comfyui_dir()
        if comfy_dir:
            self.var_dest.set(comfy_dir)
            self.status.config(text=f"ComfyUI detectado: {comfy_dir}",
                                foreground="green")
        else:
            self.var_dest.set("(selecione manualmente)")
            self.status.config(text="Não foi possível detectar o ComfyUI.",
                                foreground="orange")

    def _pick_folder(self):
        folder = filedialog.askdirectory(
            title="Selecione a pasta raiz do ComfyUI (contém 'models/')")
        if folder:
            if os.path.isdir(os.path.join(folder, "models")):
                self.var_dest.set(folder)
                self.status.config(text=f"Pasta: {folder}", foreground="green")
            else:
                if messagebox.askyesno("Confirmar",
                        "A pasta não parece ser a raiz do ComfyUI. Usar mesmo assim?"):
                    self.var_dest.set(folder)

    def _on_download(self):
        dest = self.var_dest.get()
        if not dest or dest == "(selecione manualmente)":
            messagebox.showwarning("Pasta não definida", "Selecione a pasta."); return
        if not os.path.isdir(dest):
            messagebox.showerror("Pasta inválida", f"Não existe:\n{dest}"); return

        selected = [k for k, v in self.var_checks.items() if v.get()]
        if not selected:
            messagebox.showinfo("Nada selecionado", "Marque algum modelo."); return

        self.btn_download.config(state=tk.DISABLED)
        threading.Thread(target=self._do_download,
                          args=(selected, dest), daemon=True).start()

    def _find_download_info(self, key):
        for cat in DOWNLOADS.values():
            if key in cat:
                return cat[key]
        return None

    def _do_download(self, keys, comfy_root):
        total = len(keys)
        for i, key in enumerate(keys):
            info = self._find_download_info(key)
            if not info: continue
            target_dir = os.path.join(comfy_root, "models", info["target"])
            os.makedirs(target_dir, exist_ok=True)

            self.after(0, lambda k=key: self.status.config(
                text=f"Baixando {k} ({info['size_mb']} MB)...",
                foreground="orange"))
            self.after(0, lambda p=int(100*i/total): self.prog.config(value=p))

            try:
                path = hf_hub_download(
                    repo_id=info["repo_id"],
                    filename=info["filename"],
                    local_dir=target_dir,
                    local_dir_use_symlinks=False,
                )
                self.after(0, lambda p=int(100*(i+1)/total): self.prog.config(value=p))
                print(f"[+] {key} → {path}")
            except Exception as e:
                self.after(0, lambda k=key, e=e: messagebox.showerror(
                    "Erro no download", f"Falha em {k}:\n{e}"))
                self.after(0, lambda: self.btn_download.config(state=tk.NORMAL))
                return

        self.after(0, lambda: self.prog.config(value=100))
        self.after(0, lambda: self.status.config(
            text=f"{total} modelo(s) baixado(s)!", foreground="green"))
        self.after(0, lambda: messagebox.showinfo(
            "Download concluído",
            f"{total} modelo(s) baixado(s).\n\nReinicie o ComfyUI."))
        self.after(0, lambda: self.btn_download.config(state=tk.NORMAL))
        self.after(0, self.app.reload_models)


