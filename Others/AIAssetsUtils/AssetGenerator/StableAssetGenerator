        "5": {"inputs": {"text": neg, "clip": ["2", 0]}, "class_type": "CLIPTextEncode"},
        "6": {"inputs": {"width": w, "height": h, "batch_size": batch}, "class_type": "EmptyLatentImage"},
        "7": {"inputs": {"seed": seed, "steps": steps, "cfg": 1.0,
                         "sampler_name": "euler", "scheduler": "simple", "denoise": 1.0,
