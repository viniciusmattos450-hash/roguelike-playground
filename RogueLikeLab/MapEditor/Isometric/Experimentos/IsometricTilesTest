def default_terrain():
    return {'h': 0, 'mat': 'grass', 'form': 'flat'}


def apply_tool(tool, mx, my, cam, state, terrain, blocks, walls_h, walls_v):
    z = state['floor']
    if tool['kind'] == 'wall':
        hit = pick_wall(mx, my, cam)
        if not hit: return False
        kind, x, y = hit
        d = walls_h if kind == 'h' else walls_v
        key = (x, y, z)
        if d.get(key) != tool['wall']:
            d[key] = tool['wall']; return True
        return False
    if tool['kind'] in ('terrain', 'form', 'level'):
        tx_ty = pick_tile(mx, my, cam, terrain)
        if tx_ty is None: return False
        tx, ty = tx_ty
        t = terrain.setdefault((tx, ty), default_terrain())
        if tool['kind'] == 'terrain':
            if t['mat'] != tool['mat']:
                t['mat'] = tool['mat']; return True
        elif tool['kind'] == 'form':
            if t['form'] != tool['form']:
                t['form'] = tool['form']; return True
        elif tool['kind'] == 'level':
            new_h = max(0, min(NUM_FLOORS, t['h'] + tool['delta']))
            if new_h != t['h']:
                t['h'] = new_h; return True
        return False
    wx, wy = screen_to_world(mx, my, cam)
    tx = int(math.floor(wx)); ty = int(math.floor(wy))
    if not (0 <= tx < MAP_W and 0 <= ty < MAP_H): return False
    if tool['kind'] == 'block':
        k = (tx, ty, z)
        if blocks.get(k) != tool['blk']:
            blocks[k] = tool['blk']; return True
    return False


def erase_tool(tool, mx, my, cam, state, terrain, blocks, walls_h, walls_v):
    z = state['floor']
    if tool['kind'] == 'wall':
        hit = pick_wall(mx, my, cam)
        if not hit: return False
        kind, x, y = hit
        d = walls_h if kind == 'h' else walls_v
        key = (x, y, z)
        if key in d:
            del d[key]; return True
        return False
    if tool['kind'] in ('terrain', 'form', 'level'):
        tx_ty = pick_tile(mx, my, cam, terrain)
        if tx_ty is None: return False
        tx, ty = tx_ty
        t = terrain.get((tx, ty))
        if t is not None and (t['h'] != 0 or t['mat'] != 'grass' or t['form'] != 'flat'):
            terrain[(tx, ty)] = default_terrain(); return True
        return False
    wx, wy = screen_to_world(mx, my, cam)
    tx = int(math.floor(wx)); ty = int(math.floor(wy))
    if not (0 <= tx < MAP_W and 0 <= ty < MAP_H): return False
    if tool['kind'] == 'block':
        k = (tx, ty, z)
        if k in blocks:
            del blocks[k]; return True
    return False


def apply_sprite(mx, my, cam, state, terrain, placed_sprites, erase=False):
    if active_sprite_idx is None: return False
    tx_ty = pick_tile(mx, my, cam, terrain)
    if tx_ty is None: return False
    tx, ty = tx_ty
    z = state['floor']
    k = (tx, ty, z)
    if erase:
        if k in placed_sprites:
            del placed_sprites[k]; return True
        return False
    if placed_sprites.get(k) != active_sprite_idx:
        placed_sprites[k] = active_sprite_idx; return True
    return False


