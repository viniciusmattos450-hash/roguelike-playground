def handle_props_click(mx, my, button):
    global dragging_slider, active_sprite_idx
    if not (state_mode == 'sprite' and active_sprite_idx is not None):
        return False
    panel = pygame.Rect(PROPS_X, PROPS_Y, PROPS_W, PROPS_H)
    if not panel.collidepoint(mx, my):
        return False
    sp = sprites_custom[active_sprite_idx]
    if PROP_BTN_RECT.collidepoint(mx, my):
        removed_id = active_sprite_idx
        for k in list(placed_sprites.keys()):
            if placed_sprites[k] == removed_id:
                del placed_sprites[k]
        del sprites_custom[removed_id]
        for k in list(placed_sprites.keys()):
            if placed_sprites[k] > removed_id:
                placed_sprites[k] -= 1
        active_sprite_idx = None if not sprites_custom else 0
        return True
    if button == 1:
        for (key, _l, vmin, vmax, _f) in PROP_SLIDERS:
            bar = prop_slider_rects[key]
            hit = bar.inflate(0, 16).collidepoint(mx, my)
            if hit:
                frac = (mx - bar.x) / max(1, bar.w)
                frac = max(0.0, min(1.0, frac))
                setattr(sp, key, vmin + frac * (vmax - vmin))
                dragging_slider = key
                return True
    return True


def handle_props_drag(mx, my):
    global dragging_slider
    if dragging_slider is None:
        return
    if not (0 <= active_sprite_idx < len(sprites_custom)):
        dragging_slider = None; return
    sp = sprites_custom[active_sprite_idx]
    for (key, _l, vmin, vmax, _f) in PROP_SLIDERS:
        if key == dragging_slider:
            bar = prop_slider_rects[key]
            frac = (mx - bar.x) / max(1, bar.w)
            frac = max(0.0, min(1.0, frac))
            setattr(sp, key, vmin + frac * (vmax - vmin))
            break


