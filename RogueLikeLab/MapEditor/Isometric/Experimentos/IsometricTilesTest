def draw_box(screen, x0, y0, x1, y1, z_bot, z_top, col, cam):
    z_unit = unit_px(cam)
    NW = world_to_screen(x0, y0, cam); NE = world_to_screen(x1, y0, cam)
    SE = world_to_screen(x1, y1, cam); SW = world_to_screen(x0, y1, cam)
    zt = z_top * z_unit; zb = z_bot * z_unit
    NW_t = (NW[0], NW[1] - zt); NE_t = (NE[0], NE[1] - zt)
    SE_t = (SE[0], SE[1] - zt); SW_t = (SW[0], SW[1] - zt)
    NW_b = (NW[0], NW[1] - zb); NE_b = (NE[0], NE[1] - zb)
    SE_b = (SE[0], SE[1] - zb); SW_b = (SW[0], SW[1] - zb)
    pygame.draw.polygon(screen, col['right'], [NW_b, NE_b, NE_t, NW_t])
    pygame.draw.polygon(screen, col['left'],  [NW_b, SW_b, SW_t, NW_t])
    pygame.draw.polygon(screen, col['top'],   [NW_t, NE_t, SE_t, SW_t])
    pygame.draw.polygon(screen, col['right'], [SE_b, NE_b, NE_t, SE_t])
    pygame.draw.polygon(screen, col['left'],  [SW_b, SE_b, SE_t, SW_t])


def draw_flat_or_ramp(screen, x, y, t, cam):
    h = t['h']; mat = t['mat']; form = t['form']
    n_h, e_h, s_h, w_h = corner_heights(form, h)
    z_unit = unit_px(cam)
    col = MAT_COLORS.get(mat, MAT_COLORS['grass'])
    N_b = world_to_screen(x,     y,     cam)
    E_b = world_to_screen(x + 1, y,     cam)
    S_b = world_to_screen(x + 1, y + 1, cam)
    W_b = world_to_screen(x,     y + 1, cam)
    N_t = (N_b[0], N_b[1] - n_h * z_unit); E_t = (E_b[0], E_b[1] - e_h * z_unit)
    S_t = (S_b[0], S_b[1] - s_h * z_unit); W_t = (W_b[0], W_b[1] - w_h * z_unit)
    if w_h > 0 or s_h > 0:
        pygame.draw.polygon(screen, col['left'], [W_b, S_b, S_t, W_t])
    if s_h > 0 or e_h > 0:
        pygame.draw.polygon(screen, col['right'], [S_b, E_b, E_t, S_t])
    top_pts = [N_t, E_t, S_t, W_t]
    pygame.draw.polygon(screen, col['top'], top_pts)
    pygame.draw.polygon(screen, dc(col['top'], 0.82), top_pts, 1)


def draw_stairs(screen, x, y, t, cam):
    h = t['h']; mat = t['mat']; form = t['form']
    direction = form.split('_')[1]
    col = MAT_COLORS.get(mat, MAT_COLORS['grass'])
    steps = []
    for k in range(N_STEPS):
        z_top = h + (N_STEPS - 1 - k) / N_STEPS
        u0 = k / N_STEPS; u1 = (k + 1) / N_STEPS
        if direction == 'n':
            y0 = y + u0; y1 = y + u1; x0, x1 = x, x + 1
        elif direction == 's':
            y0 = y + 1 - u1; y1 = y + 1 - u0; x0, x1 = x, x + 1
        elif direction == 'e':
            x0 = x + 1 - u1; x1 = x + 1 - u0; y0, y1 = y, y + 1
        else:
            x0 = x + u0; x1 = x + u1; y0, y1 = y, y + 1
        depth = (x0 + x1) * 0.5 + (y0 + y1) * 0.5
        steps.append((depth, x0, y0, x1, y1, z_top))
    steps.sort(key=lambda s: s[0])
    for _, sx0, sy0, sx1, sy1, sz_top in steps:
        draw_box(screen, sx0, sy0, sx1, sy1, 0, sz_top, col, cam)


def draw_terrain_tile(screen, x, y, t, cam):
    form = t.get('form', 'flat')
    if form.startswith('stair_'):
        draw_stairs(screen, x, y, t, cam)
    else:
        draw_flat_or_ramp(screen, x, y, t, cam)


def draw_block_diamond(screen, x, y, z, blk, dim, cam):
    if blk == 'stone_floor':   base = C_STONE_FLOOR
    elif blk == 'wood_floor':  base = C_WOOD_FLOOR
    elif blk == 'roof':        base = C_ROOF
    else:                      base = (200, 200, 200)
    col = dc(base, dim)
    z_off = z * unit_px(cam)
    N = world_to_screen(x,     y,     cam); E = world_to_screen(x + 1, y,     cam)
    S = world_to_screen(x + 1, y + 1, cam); W = world_to_screen(x,     y + 1, cam)
    pts = [(N[0], N[1] - z_off), (E[0], E[1] - z_off),
           (S[0], S[1] - z_off), (W[0], W[1] - z_off)]
    pygame.draw.polygon(screen, col, pts)
    pygame.draw.polygon(screen, dc(col, 0.85), pts, 1)


def _wall_overlay(screen, p1, p2, wh, kind, dim):
    if kind == 'door':
        t0, t1 = 0.18, 0.82; u0, u1 = 0.03, 0.90; col = C_DOOR
    else:
        t0, t1 = 0.22, 0.78; u0, u1 = 0.32, 0.76; col = C_WINDOW
    def lerp(a, b, t):
        return (a[0] + (b[0]-a[0])*t, a[1] + (b[1]-a[1])*t)
    q1 = lerp(p1, p2, t0); q2 = lerp(p1, p2, t1)
    r1 = (q1[0], q1[1] - wh * u0); r2 = (q2[0], q2[1] - wh * u0)
    r3 = (q2[0], q2[1] - wh * u1); r4 = (q1[0], q1[1] - wh * u1)
    pygame.draw.polygon(screen, dc(col, dim), [r1, r2, r3, r4])
    pygame.draw.polygon(screen, dc((20, 20, 20), dim), [r1, r2, r3, r4], 1)


def draw_wall_h(screen, x, y, z, kind, dim, cam):
    z_off = z * unit_px(cam); wh = unit_px(cam)
    p1 = world_to_screen(x,     y, cam); p2 = world_to_screen(x + 1, y, cam)
    p1 = (p1[0], p1[1] - z_off); p2 = (p2[0], p2[1] - z_off)
    p1u = (p1[0], p1[1] - wh);   p2u = (p2[0], p2[1] - wh)
    pygame.draw.polygon(screen, dc(C_WALL_H_FRONT, dim), [p1, p2, p2u, p1u])
    pygame.draw.line(screen, dc(C_WALL_H_FRONT, dim * 1.10), p1u, p2u, 2)
    if kind in ('door', 'window'):
        _wall_overlay(screen, p1, p2, wh, kind, dim)


def draw_wall_v(screen, x, y, z, kind, dim, cam):
    z_off = z * unit_px(cam); wh = unit_px(cam)
    p1 = world_to_screen(x, y,     cam); p2 = world_to_screen(x, y + 1, cam)
    p1 = (p1[0], p1[1] - z_off); p2 = (p2[0], p2[1] - z_off)
    p1u = (p1[0], p1[1] - wh);   p2u = (p2[0], p2[1] - wh)
    pygame.draw.polygon(screen, dc(C_WALL_V_FRONT, dim), [p1, p2, p2u, p1u])
    pygame.draw.line(screen, dc(C_WALL_V_FRONT, dim * 1.10), p1u, p2u, 2)
    if kind in ('door', 'window'):
        _wall_overlay(screen, p1, p2, wh, kind, dim)


