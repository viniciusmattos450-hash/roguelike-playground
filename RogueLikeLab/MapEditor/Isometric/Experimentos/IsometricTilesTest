#  CUSTOM SPRITE
# ============================================================
def load_sprite_surface(path, chroma_tolerance=18):
    """Carrega imagem. Se nao tiver alpha real, aplica chroma-key
       na cor do canto (tipicamente branco)."""
    raw = pygame.image.load(path)

    # Verifica se realmente tem alpha (amostra em grade)
    raw = raw.convert_alpha()
    w, h = raw.get_size()
    has_alpha = False
    step = max(1, min(w, h) // 30)
    for x in range(0, w, step):
        for y in range(0, h, step):
            if raw.get_at((x, y))[3] < 250:
                has_alpha = True
                break
        if has_alpha:
            break

    if has_alpha:
        return raw

    # Sem alpha real -> chroma-key na cor do canto
    bg = raw.get_at((0, 0))
    br, bg_, bb = bg[0], bg[1], bg[2]

    # So faz chroma-key se o canto for claro (branco/cinza claro)
    if br > 200 and bg_ > 200 and bb > 200:
        for x in range(w):
            for y in range(h):
                p = raw.get_at((x, y))
                if (abs(p[0] - br) <= chroma_tolerance and
                    abs(p[1] - bg_) <= chroma_tolerance and
                    abs(p[2] - bb) <= chroma_tolerance):
                    raw.set_at((x, y), (p[0], p[1], p[2], 0))
    return raw


class CustomSprite:
    def __init__(self, name, path):
        self.name = name
        self.path = path
        self.original = load_sprite_surface(path)
        self.scale    = 1.0
        self.offset_x = 0.0
        self.offset_y = 0.0
        self.anchor_x = 0.5
        self.anchor_y = 1.0
        self._cache_key = None
        self._cache = None
        self._ghost_key = None
        self._ghost = None

    def surface(self, cam_zoom=1.0):
        key = (round(self.scale, 4), round(cam_zoom, 4))
        if self._cache_key != key:
            ow = self.original.get_width()
            oh = self.original.get_height()
            w = max(1, int(ow * self.scale * cam_zoom))
            h = max(1, int(oh * self.scale * cam_zoom))
            self._cache = pygame.transform.smoothscale(self.original, (w, h))
            self._cache_key = key
        return self._cache

    def ghost(self, cam_zoom=1.0):
        s = self.surface(cam_zoom)
        key = (self._cache_key, s.get_size())
        if self._ghost_key != key:
            g = s.copy()
            g.set_alpha(140)
            self._ghost = g
            self._ghost_key = key
        return self._ghost

    def draw_at(self, screen, sx, sy, cam_zoom=1.0):
        s = self.surface(cam_zoom)
        w, h = s.get_size()
        ox = self.offset_x * cam_zoom
        oy = self.offset_y * cam_zoom
        dx = sx - self.anchor_x * w + ox
        dy = sy - self.anchor_y * h + oy
        screen.blit(s, (int(dx), int(dy)))


