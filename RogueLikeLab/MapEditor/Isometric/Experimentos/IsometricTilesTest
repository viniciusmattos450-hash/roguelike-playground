def pick_tile(mx, my, cam, terrain):
    wx, wy = screen_to_world(mx, my, cam)
    R = 10; z_unit = unit_px(cam)
    best = None; best_depth = -1e9
    tx_min = max(0, int(math.floor(wx)) - R)
    tx_max = min(MAP_W, int(math.floor(wx)) + R + 1)
    ty_min = max(0, int(math.floor(wy)) - R)
    ty_max = min(MAP_H, int(math.floor(wy)) + R + 1)
    for tx in range(tx_min, tx_max):
        for ty in range(ty_min, ty_max):
            t = terrain.get((tx, ty))
            if t is None:
                n_h = e_h = s_h = w_h = 0
            else:
                form = t.get('form', 'flat')
                pick_form = form
                if form.startswith('stair_'):
                    pick_form = 'ramp_' + form.split('_')[1]
                n_h, e_h, s_h, w_h = corner_heights(pick_form, t['h'])
            N_b = world_to_screen(tx,     ty,     cam); E_b = world_to_screen(tx + 1, ty,     cam)
            S_b = world_to_screen(tx + 1, ty + 1, cam); W_b = world_to_screen(tx,     ty + 1, cam)
            pts = [(N_b[0], N_b[1] - n_h * z_unit), (E_b[0], E_b[1] - e_h * z_unit),
                   (S_b[0], S_b[1] - s_h * z_unit), (W_b[0], W_b[1] - w_h * z_unit)]
            if point_in_poly(mx, my, pts):
                depth = tx + ty + (t['h'] * 0.01 if t else 0)
                if depth > best_depth:
                    best_depth = depth; best = (tx, ty)
    return best


def pick_wall(mx, my, cam, snap_dist=16.0):
    wx, wy = screen_to_world(mx, my, cam)
    tx = int(math.floor(wx)); ty = int(math.floor(wy))
    candidates = [('h', tx, ty), ('v', tx, ty), ('h', tx, ty + 1), ('v', tx + 1, ty)]
    best = None; best_d2 = snap_dist * snap_dist
    for kind, x, y in candidates:
        if kind == 'h':
            p1 = world_to_screen(x,     y, cam); p2 = world_to_screen(x + 1, y, cam)
        else:
            p1 = world_to_screen(x, y,     cam); p2 = world_to_screen(x, y + 1, cam)
        d2 = seg_dist_sq(mx, my, p1[0], p1[1], p2[0], p2[1])
        if d2 < best_d2:
            best_d2 = d2; best = (kind, x, y)
    return best


