def render_scene(screen, cam, state, terrain, blocks, walls_h, walls_v, placed_sprites):
    cur_z = state['floor']
    show_lower = state['show_lower']
    items = []
    for (x, y), t in terrain.items():
        h = t['h']; form = t.get('form', 'flat')
        z_sort = h + (1.0 if form != 'flat' else 0.0)
        items.append(((x + y, z_sort, 0), 'terrain', (x, y, t)))
    for (x, y, z), blk in blocks.items():
        if z > cur_z: continue
        if z < cur_z and not show_lower: continue
        dim = 1.0 if z == cur_z else 0.55
        items.append(((x + y, z, 1), 'block', (x, y, z, blk, dim)))
    for (x, y, z), kind in walls_h.items():
        if z > cur_z: continue
        if z < cur_z and not show_lower: continue
        dim = 1.0 if z == cur_z else 0.55
        items.append(((x + y, z, 2), 'wall_h', (x, y, z, kind, dim)))
    for (x, y, z), kind in walls_v.items():
        if z > cur_z: continue
        if z < cur_z and not show_lower: continue
        dim = 1.0 if z == cur_z else 0.55
        items.append(((x + y, z, 2), 'wall_v', (x, y, z, kind, dim)))
    for (x, y, z), sid in placed_sprites.items():
        if z > cur_z: continue
        if z < cur_z and not show_lower: continue
        items.append(((x + y, z, 3), 'sprite', (x, y, z, sid)))

    items.sort(key=lambda it: it[0])
    for _, k, d in items:
        if k == 'terrain':
            x, y, t = d; draw_terrain_tile(screen, x, y, t, cam)
        elif k == 'block':
            x, y, z, blk, dim = d; draw_block_diamond(screen, x, y, z, blk, dim, cam)
        elif k == 'wall_h':
            x, y, z, kind, dim = d; draw_wall_h(screen, x, y, z, kind, dim, cam)
        elif k == 'wall_v':
            x, y, z, kind, dim = d; draw_wall_v(screen, x, y, z, kind, dim, cam)
        elif k == 'sprite':
            x, y, z, sid = d
            if 0 <= sid < len(sprites_custom):
                sp = sprites_custom[sid]
                sx, sy = world_to_screen(x + 0.5, y + 0.5, cam)
                sy -= z * unit_px(cam)
                sp.draw_at(screen, sx, sy, cam.zoom)


