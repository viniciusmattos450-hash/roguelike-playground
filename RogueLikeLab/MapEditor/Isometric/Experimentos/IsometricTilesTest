# ============================================================
def main():
    global state_mode, active_sprite_idx, dragging_slider, placed_sprites
    pygame.init()
    screen = pygame.display.set_mode((WIN_W, WIN_H))
    pygame.display.set_caption("Editor Isometrico 2D - Sprites Custom")
    clock = pygame.time.Clock()
    try:
        font = pygame.font.SysFont("consolas,couriernew,monospace", 12)
        font_big = pygame.font.SysFont("consolas,couriernew,monospace", 15, bold=True)
    except Exception:
        font = pygame.font.Font(None, 14); font_big = pygame.font.Font(None, 18)

    terrain = {(x, y): default_terrain() for x in range(MAP_W) for y in range(MAP_H)}
    blocks = {}; walls_h = {}; walls_v = {}
    placed_sprites = {}

    cam = Camera()
    state = {'tool_idx': 0, 'floor': 0, 'show_lower': True,
             'show_grid': False, 'dropdown_open': False}

    lmb = rmb = False
    last_paint = None

    running = True
    while running:
        dt = min(clock.tick(FPS) / 1000.0, 0.05)

        for e in pygame.event.get():
            if e.type == pygame.QUIT:
                running = False

            elif e.type == pygame.KEYDOWN:
                if e.key == pygame.K_ESCAPE: running = False
                elif e.key == pygame.K_i:
                    if import_sprite():
                        state_mode = 'sprite'
                elif e.key == pygame.K_TAB:
                    state['floor'] = (state['floor'] + 1) % NUM_FLOORS
                    state['dropdown_open'] = False
                elif e.key == pygame.K_g:
                    state['show_grid'] = not state['show_grid']
                elif e.key == pygame.K_l:
                    state['show_lower'] = not state['show_lower']
                elif e.key == pygame.K_r:
                    for x in range(MAP_W):
                        for y in range(MAP_H):
                            terrain[(x, y)] = default_terrain()
                    blocks.clear(); walls_h.clear(); walls_v.clear()
                    placed_sprites.clear()
                elif pygame.K_1 <= e.key <= pygame.K_9:
                    idx = e.key - pygame.K_1
                    if idx < len(TOOLS):
                        state['tool_idx'] = idx
                        state_mode = 'tool'

            elif e.type == getattr(pygame, 'MOUSEWHEEL', -1):
                mx, my = pygame.mouse.get_pos()
                if mx < SCENE_W:
                    wx0, wy0 = screen_to_world(mx, my, cam)
                    cam.zoom = max(0.4, min(3.0, cam.zoom * (1.15 ** e.y)))
                    wx1, wy1 = screen_to_world(mx, my, cam)
                    cam.x += wx0 - wx1; cam.y += wy0 - wy1

            elif e.type == pygame.MOUSEBUTTONDOWN:
                mx, my = e.pos
                if e.button in (4, 5):
                    if mx < SCENE_W:
                        f = 1.15 if e.button == 4 else 1/1.15
                        wx0, wy0 = screen_to_world(mx, my, cam)
                        cam.zoom = max(0.4, min(3.0, cam.zoom * f))
                        wx1, wy1 = screen_to_world(mx, my, cam)
                        cam.x += wx0 - wx1; cam.y += wy0 - wy1
                    continue

                if handle_props_click(mx, my, e.button):
                    continue

                if mx >= SCENE_W:
                    if state['dropdown_open']:
                        for i, r in enumerate(DROP_ITEM_RECTS):
                            if r.collidepoint(mx, my):
                                state['floor'] = i
                                break
                        state['dropdown_open'] = False
                        continue
                    if DROP_RECT.collidepoint(mx, my):
                        state['dropdown_open'] = True
                        continue
                    for i, r in enumerate(TOOL_RECTS):
                        if r.collidepoint(mx, my):
                            state['tool_idx'] = i
                            state_mode = 'tool'
                            break
                    else:
                        if SPRITE_IMPORT_RECT.collidepoint(mx, my):
                            if import_sprite():
                                state_mode = 'sprite'
                            continue
                        for i, r in enumerate(SPRITE_ITEM_RECTS):
                            if r.collidepoint(mx, my):
                                active_sprite_idx = i
                                state_mode = 'sprite'
                                break
                    continue

                if state_mode == 'sprite':
                    if e.button == 1:
                        apply_sprite(mx, my, cam, state, terrain,
                                     placed_sprites, erase=False)
                        lmb = True
                    elif e.button == 3:
                        apply_sprite(mx, my, cam, state, terrain,
                                     placed_sprites, erase=True)
                        rmb = True
                else:
                    tool = TOOLS[state['tool_idx']]
                    if e.button == 1:
                        apply_tool(tool, mx, my, cam, state,
                                   terrain, blocks, walls_h, walls_v)
                        lmb = True; last_paint = (mx, my, False)
                    elif e.button == 3:
                        erase_tool(tool, mx, my, cam, state,
                                   terrain, blocks, walls_h, walls_v)
                        rmb = True; last_paint = (mx, my, True)

            elif e.type == pygame.MOUSEBUTTONUP:
                if e.button == 1:
                    lmb = False; last_paint = None
                    dragging_slider = None
                if e.button == 3: rmb = False; last_paint = None

            elif e.type == pygame.MOUSEMOTION:
                mx, my = e.pos
                if dragging_slider is not None:
                    handle_props_drag(mx, my)
                    continue
                if (lmb or rmb) and mx < SCENE_W:
                    if last_paint:
                        dx = mx - last_paint[0]; dy = my - last_paint[1]
                        if dx*dx + dy*dy < 16: continue
                    if state_mode == 'sprite':
                        if rmb:
                            apply_sprite(mx, my, cam, state, terrain,
                                         placed_sprites, erase=True)
                        else:
                            apply_sprite(mx, my, cam, state, terrain,
                                         placed_sprites, erase=False)
                        last_paint = (mx, my, rmb)
                    else:
                        tool = TOOLS[state['tool_idx']]
                        if rmb:
                            erase_tool(tool, mx, my, cam, state,
                                       terrain, blocks, walls_h, walls_v)
                        else:
                            apply_tool(tool, mx, my, cam, state,
                                       terrain, blocks, walls_h, walls_v)
                        last_paint = (mx, my, rmb)

        keys = pygame.key.get_pressed()
        spd = 10.0 / cam.zoom
        ddx = ddy = 0
        if keys[pygame.K_a]: ddx -= 1
        if keys[pygame.K_d]: ddx += 1
        if keys[pygame.K_w]: ddy -= 1
        if keys[pygame.K_s]: ddy += 1
        if ddx or ddy:
            m = math.hypot(ddx, ddy); ddx /= m; ddy /= m
            wdx = ddx * 0.5 + ddy * 0.5
            wdy = -ddx * 0.5 + ddy * 0.5
            mm = math.hypot(wdx, wdy)
            if mm > 1e-6: wdx /= mm; wdy /= mm
            cam.x += wdx * spd * dt; cam.y += wdy * spd * dt
        cam.x = max(-5, min(MAP_W + 5, cam.x))
        cam.y = max(-5, min(MAP_H + 5, cam.y))

        screen.fill((22, 26, 34))
        render_scene(screen, cam, state, terrain, blocks, walls_h, walls_v,
                     placed_sprites)
        if state['show_grid']:
            draw_grid(screen, cam, state['floor'])
        draw_hover(screen, cam, state, terrain)
        draw_palette(screen, font, font_big, state)
        draw_props_panel(screen, font, font_big)
        draw_hud(screen, font, cam, state)

        pygame.display.flip()

    pygame.quit()
    sys.exit()


if __name__ == "__main__":
    main()