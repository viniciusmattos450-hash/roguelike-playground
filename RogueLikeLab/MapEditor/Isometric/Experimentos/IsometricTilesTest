def import_sprite():
    global active_sprite_idx
    path = None
    if HAS_TK:
        root = tk.Tk(); root.withdraw()
        path = filedialog.askopenfilename(
            title="Escolha a imagem",
            filetypes=[("Imagens", "*.png *.jpg *.jpeg *.bmp *.gif"),
                       ("Todos", "*.*")])
        root.destroy()
    else:
        try:
            path = input("Caminho da imagem: ").strip().strip('"').strip("'")
        except EOFError:
            path = None
    if not path:
        return False
    try:
        name = path.replace('\\', '/').split('/')[-1]
        sp = CustomSprite(name, path)
        sprites_custom.append(sp)
        active_sprite_idx = len(sprites_custom) - 1
        return True
    except Exception as e:
        print(f"[Import] Erro: {e}")
        return False


