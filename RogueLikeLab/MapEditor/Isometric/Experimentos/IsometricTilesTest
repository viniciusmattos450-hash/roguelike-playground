#  CAMERA / PROJECAO
# ============================================================
class Camera:
    def __init__(self):
        self.x = MAP_W * 0.5
        self.y = MAP_H * 0.5
        self.zoom = 1.0


def tile_size(cam):
    return BASE_TILE_W * cam.zoom, BASE_TILE_H * cam.zoom


def unit_px(cam):
    return BASE_WALL_H * cam.zoom


def world_to_screen(px, py, cam):
    tw, th = tile_size(cam)
    dx = px - cam.x; dy = py - cam.y
    sx = SCENE_W * 0.5 + (dx - dy) * tw * 0.5
    sy = WIN_H * 0.5 + (dx + dy) * th * 0.5
    return sx, sy


def screen_to_world(mx, my, cam):
    tw, th = tile_size(cam)
    sx = (mx - SCENE_W * 0.5) / (tw * 0.5)
    sy = (my - WIN_H * 0.5) / (th * 0.5)
    dx = (sx + sy) * 0.5
    dy = (sy - sx) * 0.5
    return cam.x + dx, cam.y + dy


def seg_dist_sq(px, py, x1, y1, x2, y2):
    dx = x2 - x1; dy = y2 - y1
    dd = dx*dx + dy*dy
    if dd < 1e-9:
        return (px - x1)**2 + (py - y1)**2
    t = ((px - x1)*dx + (py - y1)*dy) / dd
    t = max(0.0, min(1.0, t))
    ex = x1 + dx*t; ey = y1 + dy*t
    return (px - ex)**2 + (py - ey)**2


def dc(c, f):
    return (max(0, min(255, int(c[0]*f))),
            max(0, min(255, int(c[1]*f))),
            max(0, min(255, int(c[2]*f))))


def point_in_poly(px, py, pts):
    n = len(pts); inside = False; j = n - 1
    for i in range(n):
        xi, yi = pts[i]; xj, yj = pts[j]
        if ((yi > py) != (yj > py)) and \
           (px < (xj - xi) * (py - yi) / (yj - yi + 1e-12) + xi):
            inside = not inside
        j = i
    return inside


