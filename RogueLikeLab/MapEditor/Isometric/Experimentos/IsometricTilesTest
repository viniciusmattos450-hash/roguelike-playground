def draw_hover(screen, cam, state, terrain):
    mx, my = pygame.mouse.get_pos()
    if mx >= SCENE_W: return

    if state_mode == 'sprite' and active_sprite_idx is not None:
        tx_ty = pick_tile(mx, my, cam, terrain)
        if tx_ty is None: return
        tx, ty = tx_ty
        z = state['floor']
        sp = sprites_custom[active_sprite_idx]
        sx, sy = world_to_screen(tx + 0.5, ty + 0.5, cam)
        sy -= z * unit_px(cam)
        g = sp.ghost(cam.zoom)
        w, h = g.get_size()
        ox = sp.offset_x * cam.zoom
        oy = sp.offset_y * cam.zoom
        dx = sx - sp.anchor_x * w + ox
        dy = sy - sp.anchor_y * h + oy
        screen.blit(g, (int(dx), int(dy)))
        N = world_to_screen(tx,     ty,     cam); E = world_to_screen(tx + 1, ty,     cam)
        S = world_to_screen(tx + 1, ty + 1, cam); W = world_to_screen(tx,     ty + 1, cam)
        z_off = z * unit_px(cam)
        pts = [(N[0], N[1] - z_off), (E[0], E[1] - z_off),
               (S[0], S[1] - z_off), (W[0], W[1] - z_off)]
        pygame.draw.polygon(screen, (255, 240, 100), pts, 2)
        return

    tool = TOOLS[state['tool_idx']]
    z = state['floor']
    surf = pygame.Surface((SCENE_W, WIN_H), pygame.SRCALPHA)

    if tool['kind'] == 'wall':
        hit = pick_wall(mx, my, cam)
        if hit:
            kind, x, y = hit
            z_off = z * unit_px(cam); wh = unit_px(cam)
            if kind == 'h':
                p1 = world_to_screen(x,     y, cam); p2 = world_to_screen(x + 1, y, cam)
            else:
                p1 = world_to_screen(x, y,     cam); p2 = world_to_screen(x, y + 1, cam)
            p1 = (p1[0], p1[1] - z_off); p2 = (p2[0], p2[1] - z_off)
            pts = [p1, p2, (p2[0], p2[1] - wh), (p1[0], p1[1] - wh)]
            pygame.draw.polygon(surf, (255, 240, 100, 100), pts)
            screen.blit(surf, (0, 0))
            pygame.draw.polygon(screen, (255, 240, 100), pts, 2)
    else:
        tx_ty = pick_tile(mx, my, cam, terrain)
        if tx_ty is None: return
        tx, ty = tx_ty
        t = terrain.get((tx, ty))
        if t is None:
            n_h = e_h = s_h = w_h = 0
        else:
            form = t.get('form', 'flat')
            pick_form = form
            if form.startswith('stair_'):
                pick_form = 'ramp_' + form.split('_')[1]
            n_h, e_h, s_h, w_h = corner_heights(pick_form, t['h'])
        z_unit = unit_px(cam)
        N = world_to_screen(tx,     ty,     cam); E = world_to_screen(tx + 1, ty,     cam)
        S = world_to_screen(tx + 1, ty + 1, cam); W = world_to_screen(tx,     ty + 1, cam)
        pts = [(N[0], N[1] - n_h * z_unit), (E[0], E[1] - e_h * z_unit),
               (S[0], S[1] - s_h * z_unit), (W[0], W[1] - w_h * z_unit)]
        pygame.draw.polygon(surf, (255, 240, 100, 80), pts)
        screen.blit(surf, (0, 0))
        pygame.draw.polygon(screen, (255, 240, 100), pts, 2)


